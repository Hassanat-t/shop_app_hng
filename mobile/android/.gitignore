# Build caches and generated output
/.gradle
/build/
/captures/
.cxx/
GeneratedPluginRegistrant.java

# Flutter's stock template ignores the wrapper, but this project relies on it:
# tool/dev.ps1 calls gradlew.bat, so the wrapper must be committed for the build
# to be reproducible on a fresh clone.
!/gradlew
!/gradlew.bat
!/gradle/wrapper/gradle-wrapper.jar
# Generated per-machine SDK paths (flutter.sdk / sdk.dir) must stay untracked.
/local.properties

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
